{
  "name": "yakanban",
  "displayName": "YAKanban",
  "description": "Lightweight file-based Kanban board. Tickets stored as markdown files for easy human and AI access.",
  "version": "0.1.1",
  "publisher": "jackboylan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackboyla/YAKanban.git"
  },
  "bugs": {
    "url": "https://github.com/jackboyla/YAKanban/issues"
  },
  "homepage": "https://github.com/jackboyla/YAKanban#readme",
  "keywords": [
    "kanban",
    "markdown",
    "tasks",
    "tickets",
    "ai-agents",
    "project-management"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:yakanban.boardView",
    "onCommand:yakanban.openBoard",
    "onCommand:yakanban.init",
    "onCommand:yakanban.addTicket",
    "onCommand:yakanban.addColumn"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yakanban",
          "title": "YAKanban",
          "icon": "media/kanban-icon.svg"
        }
      ]
    },
    "views": {
      "yakanban": [
        {
          "id": "yakanban.boardView",
          "name": "Board"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "yakanban.boardView",
        "contents": "Your Kanban board opens in the editor panel.\nClick this icon again to reopen it."
      }
    ],
    "commands": [
      {
        "command": "yakanban.openBoard",
        "title": "Open Kanban Board",
        "category": "YAKanban"
      },
      {
        "command": "yakanban.init",
        "title": "Initialize Board",
        "category": "YAKanban"
      },
      {
        "command": "yakanban.addTicket",
        "title": "Add Ticket",
        "category": "YAKanban"
      },
      {
        "command": "yakanban.addColumn",
        "title": "Add Column",
        "category": "YAKanban"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  }
}
